<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      Only the splash screen is styled here: the app draws edge to edge and the system bar
      appearance is driven by enableEdgeToEdge() in MainActivity, so the android:statusBarColor /
      android:navigationBarColor / android:windowLightStatusBar attributes are both deprecated
      and, on API 35+, ignored.
    -->
    <style name="Theme.LanguageSelector" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowSplashScreenBackground">@color/app_background</item>
    </style>
</resources>
